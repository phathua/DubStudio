{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DubStudio",
  "version": "0.1.0",
  "identifier": "com.vixlab.dubstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DubStudio",
        "width": 1200,
        "height": 790,
        "minWidth": 760,
        "minHeight": 550,
        "visible": false,
        "decorations": false,
        "center": true
      },
      {
        "label": "splash",
        "title": "DubStudio",
        "url": "index.html?splash=1",
        "width": 520,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
